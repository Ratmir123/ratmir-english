{
  "appId": "com.ratmir.english",
  "productName": "Smooth Talk",
  "copyright": "Smooth Talk",
  "directories": {
    "app": "desktop",
    "output": ".runtime/desktop-dist"
  },
  "files": [
    "*.cjs",
    "package.json",
    "!node_modules{,/**/*}"
  ],
  "beforeBuild": "scripts/desktop-before-build.cjs",
  "extraFiles": [
    {
      "from": "public/icon-smooth-v042.ico",
      "to": "resources/app-icons/icon.ico"
    }
  ],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      }
    ],
    "icon": "public/icon-smooth-v042.ico",
    "executableName": "Ratmir English"
  },
  "nsis": {
    "oneClick": true,
    "perMachine": false,
    "allowElevation": false,
    "runAfterFinish": false,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Smooth Talk",
    "artifactName": "Smooth Talk Setup.${ext}"
  }
}
