# The local Codex login is used by Codex itself. Do not copy auth.json here.
# Brain model is fixed in the bridge to gpt-6.1-sol.
# Set only if codex.exe is not on PATH.
CODEX_BIN=
# Local Codex remains the default. The VPS path uses the app's own SIWC OAuth.
TRAINING_DEPLOYMENT=local
TRAINING_BRAIN_AUTH=codex
# In server mode all four are required: siwc, HTTPS origin, 32+ character code,
# and an absolute directory for private SIWC credentials on persistent storage.
TRAINING_PUBLIC_ORIGIN=
TRAINING_SIWC_DIR=
# Optional OpenAI audio API. Never put this key in NEXT_PUBLIC variables.
OPENAI_API_KEY=
OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_VOICE=marin
# Monthly audio budget is saved in the personal profile (Settings).
# Required before accepting a phone connection. A long random personal access code.
TRAINING_ACCESS_CODE=
