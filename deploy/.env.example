# Template only. Copy to deploy/.env on the future VPS, then fill it privately.
# Never commit deploy/.env or paste its values into a chat/log.
TRAINING_DOMAIN=training.example.com
TRAINING_PUBLIC_ORIGIN=https://training.example.com

# Generate at least 32 random characters. Empty values prevent Compose startup.
TRAINING_ACCESS_CODE=

# These server settings are fixed by compose.yaml; listed here for clarity.
TRAINING_DEPLOYMENT=server
TRAINING_BRAIN_AUTH=siwc
TRAINING_MANAGED_SERVER=1
TRAINING_SIWC_DIR=/app/.data/siwc

# Optional server-only audio key. Alternatively, configure audio in the UI.
# SIWC supplies the training model; this key is only for transcription and TTS.
OPENAI_API_KEY=
