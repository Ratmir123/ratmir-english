# Allow only executable application sources and required build metadata.
# Personal documents, Git history, credentials and local data are excluded by default.
**
!Dockerfile
!package.json
!package-lock.json
!tsconfig.json
!next.config.ts
!instrumentation.ts

!app/**
!components/**
!lib/**
!public/icon.svg
!public/icon-192.png
!public/icon-512.png
!public/icon-pearl-v04-64.png
!public/icon-pearl-v04-192.png
!public/icon-pearl-v04-512.png
!public/icon-pearl-v04.ico
!public/rewards-v041/first-practice.png
!public/rewards-v041/three-days.png
!public/rewards-v041/ten-practices.png
!public/rewards-v041/own-improvement.png
!public/rewards-v041/balanced-worlds.png
!public/rewards-v041/independent-listening.png
!public/rewards-v041/four-sides.png
!public/rewards-v041/rank-pearl.png
!public/rewards-v041/rank-mint.png
!public/rewards-v041/rank-sky.png
!public/rewards-v041/rank-violet.png
!public/rewards-v041/rank-rose.png
!public/rewards-v041/rank-gold.png
!public/*.html
!public/*.js
!scripts/connect-chatgpt.ts
!scripts/host-server.mjs
!scripts/voice-relay.mjs
!deploy/healthcheck.mjs

# Keep these exclusions last, including inside otherwise allowed directories.
**/.env*
**/.data
**/.data/**
**/.runtime
**/.runtime/**
**/.git
**/.git/**
**/node_modules
**/node_modules/**
**/.next
**/.next/**
**/*.md
**/*.json
**/*.sqlite*
**/*.db
**/*.pem
**/*.key
**/*.log
**/credentials.json
**/auth.json

# The only JSON inputs are dependency manifests and TypeScript configuration.
!package.json
!package-lock.json
!tsconfig.json
